diff --git a/custom_components/ble_led_pixel/fonts.py b/custom_components/ble_led_pixel/fonts.py
index c268ce9..25fcda1 100644
--- a/custom_components/ble_led_pixel/fonts.py
+++ b/custom_components/ble_led_pixel/fonts.py
@@ -208,6 +208,17 @@ def resolve_font_for_library(font_name: str | None) -> str:
         locations, otherwise the name unchanged so the library can still try
         to resolve it as one of its own.
     """
+    # Already resolved: text.py resolves the name before calling the API,
+    # which resolves it again. The font index is keyed by file name, so an
+    # absolute path missed, and every font silently became FALLBACK_FONT
+    # (VCR_OSD_MONO, which has no Polish letters).
+    if font_name and Path(font_name).is_absolute() and Path(font_name).is_file():
+        return font_name
+    # The library's own built-in font (pypixelcolor 0.5: UNIFONT) has no file
+    # here; without this it was always replaced by FALLBACK_FONT.
+    if font_name and font_name.upper() == "UNIFONT":
+        return font_name
+
     for candidate in (font_name, FALLBACK_FONT):
         if not candidate:
             continue
