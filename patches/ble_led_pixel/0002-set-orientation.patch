+        """Rotate the display: 0 = 0°, 1 = 90°, 2 = 180°, 3 = 270°.
+
+        The panel does not keep this across a power cut, so it has to be sent
+        again whenever the panel comes back.
+        """
+        try:
+            command = make_orientation_command(orientation)
+        except ValueError as err:
+            _LOGGER.error("Invalid orientation value: %s", err)
+            return False
+        success = await self._send_with_reconnect(command)
+        if success:
+            _LOGGER.debug("Orientation set to %d", orientation)
