     ])
 
 
+def make_orientation_command(orientation: int) -> bytes:
+    """Build the orientation command.
+
+    Frame: [5, 0, 6, 0x80, orientation], from pypixelcolor set_orientation.
+    0 = 0°, 1 = 90°, 2 = 180°, 3 = 270°.
+
+    The panel forgets the orientation when it loses power, so whoever owns
+    the panel has to send it again after a power cut.
+
+    Raises:
+        ValueError: If orientation is not 0-3.
+    """
+    if orientation not in (0, 1, 2, 3):
+        raise ValueError("Orientation must be between 0 and 3")
+    return bytes([5, 0, 6, 0x80, orientation])
+
